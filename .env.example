# --- Database ---
# Self-hosted (docker compose): set POSTGRES_PASSWORD; compose builds DATABASE_URL.
POSTGRES_PASSWORD=""
# Anywhere else (Neon, local Postgres): set DATABASE_URL directly.
DATABASE_URL="postgresql://user:pass@host:5432/cryptothreads?sslmode=require"

# --- Logo sourcing ---
BRANDFETCH_CLIENT_ID=""          # https://brandfetch.com/developers (Logo API, free)
COINGECKO_DEMO_KEY=""            # https://www.coingecko.com/en/api (demo key, 30/min)
# CRYPTOICONS_BASE=               # optional override of the cryptoicons SVG base URL

# --- Storage ---
BLOB_READ_WRITE_TOKEN=""         # Vercel Blob. If empty, assets go to STORAGE_DIR and are served at /cache/...
# STORAGE_DIR=".data/cache"      # local asset dir (compose mounts a volume at /data/cache)

# --- Printful ---
PRINTFUL_API_TOKEN=""
PRINTFUL_STORE_ID=""
PRINTFUL_WEBHOOK_SECRET=""
PRINTFUL_AUTO_CONFIRM=""         # set to 1 to auto-confirm (bill) Printful orders; else they stay draft
PF_MOCKUP_VARIANT_CAP="4"        # how many variants to request mockups for per product
# Catalog product IDs — CONFIRM against GET /v2/catalog-products before launch
PF_BLANK_TEE="71"
PF_BLANK_HOODIE="146"
PF_BLANK_MUG="19"

# --- Payments ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# --- Site ---
SITE_URL="http://localhost:3000"   # public https origin in production; Printful fetches print files from it
ADMIN_TOKEN=""                   # simple bearer for /api/admin/* + /api/generate during early build
SHIPPING_FLAT_CENTS="500"        # flat shipping added at checkout (until live rates)
SHIP_COUNTRIES="US"              # comma-separated ISO codes checkout accepts
SUPPORT_EMAIL=""                 # shown in the footer and the shipping & returns policy

# --- Daily drop routine ---
DAILY_DROP_COUNT="2"
VERCEL_DEPLOY_HOOK_URL=""        # optional: POST'd after a drop to trigger redeploy
