# --- Database (Postgres: Neon or Vercel Postgres) ---
DATABASE_URL="postgresql://user:pass@host:5432/cryptothreads?sslmode=require"

# --- Logo sourcing ---
BRANDFETCH_CLIENT_ID=""          # https://brandfetch.com/developers (Logo API, free)
COINGECKO_DEMO_KEY=""            # https://www.coingecko.com/en/api (demo key, 30/min)
# CRYPTOICONS_BASE=               # optional override of the cryptoicons SVG base URL

# --- Storage ---
BLOB_READ_WRITE_TOKEN=""         # Vercel Blob. If empty, assets are written to public/cache (local dev)

# --- Printful ---
PRINTFUL_API_TOKEN=""
PRINTFUL_STORE_ID=""
PRINTFUL_WEBHOOK_SECRET=""

# --- Payments ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_TOKEN=""                   # simple bearer for /api/admin/* during early build
