// CryptoThreads schema — see ~/.claude/plans/enchanted-leaping-starlight.md
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DesignMode {
  STYLIZED
  EXACT
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISABLED // admin kill-switch / IP takedown
}

enum OrderStatus {
  PENDING
  PAID
  SUBMITTED // sent to Printful
  FULFILLED
  SHIPPED
  CANCELLED
  FAILED
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

/// Resolved-once logo cache. Checked before any external lookup.
model LogoCache {
  id          String   @id @default(cuid())
  // identity keys (any may be null; at least one set)
  symbol      String?  @unique // upper-case ticker, e.g. "UNI"
  domain      String?  @unique // e.g. "uniswap.org"
  coingeckoId String?  @unique // e.g. "uniswap"
  name        String?
  // resolved asset
  source      String // "brandfetch" | "cryptoicons" | "coingecko"
  isVector    Boolean  @default(false)
  assetUrl    String // public URL to stored svg/png (Blob or /cache)
  assetKey    String // storage key
  contentType String // "image/svg+xml" | "image/png" ...
  palette     Json? // dominant colors for templating
  width       Int?
  height      Int?
  fetchedAt   DateTime @default(now())
  ttlSeconds  Int      @default(2592000) // 30d refresh window

  designs Design[]

  @@index([fetchedAt])
}

model Design {
  id              String     @id @default(cuid())
  logo            LogoCache  @relation(fields: [logoId], references: [id])
  logoId          String
  mode            DesignMode @default(STYLIZED)
  template        String
  /// Print style id (see src/lib/design/styles.ts) and slogan id, for STYLIZED designs.
  style           String     @default("ticker")
  slogan          String?
  printFileUrl    String? // print-ready PNG (Blob)
  printFileKey    String?
  previewUrl      String? // small web preview
  createdAt       DateTime   @default(now())
  products        Product[]
}

model Product {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  /// The ticker/website the design was generated from; re-used at fulfillment.
  query             String?
  design            Design        @relation(fields: [designId], references: [id])
  designId          String
  blankType         String // "tee" | "hoodie" | "mug"
  printfulProductId String?
  variants          Json? // [{variantId, size, color, priceCents}]
  mockupUrls        String[]
  baseCostCents     Int           @default(0)
  priceCents        Int           @default(0)
  status            ProductStatus @default(DRAFT)
  /// Engagement, for ranking: page views, add-to-carts, paid orders.
  views             Int           @default(0)
  carts             Int           @default(0)
  orders            Int           @default(0)
  /// Set when the freshness check pulled it (coin went quiet); cleared when it comes back.
  retiredReason     String?
  createdAt         DateTime      @default(now())
}

model Order {
  id               String          @id @default(cuid())
  email            String
  items            Json // [{productId, variantId, qty, priceCents}]
  shipping         Json
  subtotalCents    Int
  totalCents       Int
  provider         PaymentProvider
  paymentStatus    PaymentStatus   @default(UNPAID)
  externalPayId    String? // Stripe Checkout session id
  printfulOrderId  String?
  status           OrderStatus     @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([externalPayId])
}

model ContentPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  bodyMdx     String
  coinRefs    String[] // symbols featured
  productIds  String[]
  /// Trending slogans in this drop (one section each), in display order.
  sloganIds   String[] @default([])
  coverUrl    String?
  publishedAt DateTime @default(now())

  @@index([publishedAt])
}

/// Gates EXACT-logo mode to merch-friendly tokens.
model Allowlist {
  id                  String   @id @default(cuid())
  symbol              String?  @unique
  domain              String?  @unique
  exactLogoPermitted  Boolean  @default(false)
  notes               String?
  createdAt           DateTime @default(now())
}

/// Slogans found on crypto X / Reddit by the daily trend collector
/// (tools/trends/collect.py). Shown in the Trending section until expiresAt;
/// expired ones still resolve so carts and orders keep printing them.
model TrendingSlogan {
  id         String   @id // "t-<slug of the text>"
  lines      String[]
  ticker     String // coin it's shown on
  style      String // print style it's shown in
  blurb      String // one line on where it came from
  source     String // "x" | "reddit" | "coingecko" | ...
  score      Float    @default(0)
  previewUrl String?
  hidden     Boolean  @default(false) // admin kill switch; blocks new orders too
  /// Proven seller: stays in the studio after it expires from the home page.
  pinned     Boolean  @default(false)
  views      Int      @default(0)
  carts      Int      @default(0)
  orders     Int      @default(0)
  /// Likes on its @FloorFeed post, read back by the collector.
  likes      Int      @default(0)
  tweetUrl   String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
}

enum SubmissionStatus {
  LIVE // on the board, open for votes
  PROMOTED // made it into the trending set
  HIDDEN // admin pulled it
}

/// "Shill us yours": coin + slogan ideas from shoppers, voted on at /shill.
model Submission {
  id        String           @id @default(cuid())
  lines     String[]
  ticker    String
  ipHash    String
  votes     Int              @default(0)
  status    SubmissionStatus @default(LIVE)
  /// TrendingSlogan id once promoted.
  sloganId  String?
  createdAt DateTime         @default(now())

  ballots Vote[]

  @@index([status, votes])
}

model Vote {
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  voterHash    String
  createdAt    DateTime   @default(now())

  @@id([submissionId, voterHash])
}
